        .TITLE  CELWAR
        .SBTTL  CellWar - the game
;-----------------------------------------------------------------------
; CELWAR.MAC - CellWar on a PDP-11 under RT-11: a war of cells on a board
; of 20 x 10, the human against the machine, in the fog.
;
; The rules.  Every unit makes exactly one move a round, given as a
; step (dx, dy) of -1..1 each; what the step does depends on the unit's
; stage.  A unit has four stages, one counter that standing raises and
; moving spends: the infantry, fortification 1, fortification 2, the
; factory.  Standing (0,0) raises the stage by one; a factory that
; stands stays a factory.  A combat unit (the first three stages) that
; steps becomes an infantry and goes: onto an empty cell it moves; onto
; an enemy infantry or factory it kills it and takes the cell; onto an
; enemy fortification it dies and the fortification becomes an infantry
; (a second attacker the same round kills that); onto its own unit, or
; off the map, it cannot go.  A factory that steps onto an empty cell
; makes a new infantry there and drops to fortification 1; it cannot
; step anywhere else.  A unit made this round has moved already.  A
; player moves all their combat units first, then their factories.  A
; player sees the cells within 1 of each of their units, within 2 of a
; fortification; what a unit saw at the start of the turn stays in view
; until the turn ends.  The last player with a unit wins.
;
; Nothing of the machine is here.  The screen, the keys, the click and
; the clock are the routines of MS0515.MAC, described at its top; the
; tiles and the font are ART.MAC's (source/gen_art.py draws them).
;
; The board is BOARD: 20 x 10 cells inside a frame two cells wide, row
; major, a byte a cell (the frame is CEDGE; the harness under tests/
; reads and writes it as laid out here).  A cell is 0 when empty, or
; CUNIT with the owner (COWN: the computer's), CMOVD (moved this round)
; and the stage in bits 0-1.  VISH and VISC are the two players' views,
; a byte a cell, 1 when in view this turn.
;
; Registers: R0-R2 carry arguments and results; a routine may use any
; register unless it says otherwise (the machine's keep R3-R5).  MOVB
; sign-extends into a register, so a byte used as a number is masked
; (BIC #177400) first.
;-----------------------------------------------------------------------
        .MCALL  .EXIT,.LOOKUP,.ENTER,.READW,.WRITW,.CLOSE
        .GLOBL  HWINIT,HWEXIT,KEY,KFLUSH,CLRSCR,DRAWC,DRAWBM,TEXT,TATTR
        .GLOBL  CLICK,SNDHIT,SNDMOV,SNDSTD,SNDNEW,WAIT,FRAMES
        .GLOBL  TFOG,TEMPTY,TINF,TFRT1,TFRT2,TFAC,LOGO
        .GLOBL  BOARD,VISH,VISC,TURN,PHASE,ROUND,GSTATE,SEL,CDX,CDY
        .GLOBL  SEED,HCNT,CCNT,MODE     ; the state, named in the link map for the tests

; --- the board ----------------------------------------------------------
WIDTH  = 20.
HEIGHT = 10.
PW     = 24.                    ; the padded row: two edge cells each side
PH     = 14.
NCELLS = PW*PH                  ; 336
CELL0  = <2*PW>+2               ; the index of (0,0)
CUNIT  = 200                    ; a unit is here
COWN   = 100                    ; the computer's (clear: the human's)
CMOVD  = 10                     ; has moved this round
CSTG   = 3                      ; the stage: 0 infantry, 1 and 2
SFACT  = 3                      ;   fortification, 3 the factory
CEDGE  = 40                     ; off the map: not a unit, not empty

; --- the keys, as the MS7004 sends them --------------------------------
KTAB   = 276
KSPC   = 324
KUP    = 252
KDOWN  = 251
KLEFT  = 247
KRIGHT = 250
KS     = 316
KL     = 347
KQ     = 303
KN     = 334

; --- the colours: an attribute byte is flash, bright, paper, ink -------
ABRT   = 100                    ; bright
AFLSH  = 200                    ; flash: the cursor
AHUM   = 4                      ; the human's units: green
ACPU   = 2                      ; the computer's: red
ASEL   = 10                     ; the selected unit: on blue paper
AHIL1  = 70                     ; the computer's unit about to move: white paper
AHIL2  = 60                     ; where it goes: yellow paper
AFLS   = 120                    ; a blow landing: bright red paper
AFOG   = 1                      ; the fog: dim blue
AEMP   = 7                      ; an empty cell in view: dim white
ATXT   = 107                    ; the text: bright white
AHLP   = 7                      ; the help line: dim white

; --- the start: the title, the demo, the game ----------------------------
; MODE says which is on: 0 the title, 1 the demo, 2 the game.  The title
; waits ten seconds for SPACE (the game) or Q (RT-11), then the demo
; plays the computer against itself with the whole board in view until
; one of those keys; a demo game over brings the title back.
START:  JSR     PC,XYINIT
        JSR     PC,HWINIT
TITLE:  CLR     MODE
        JSR     PC,DRWTTL
        MOV     #500.,R0
        JSR     PC,DWAIT
        MOV     DEMOKY,R0
        CLR     DEMOKY
        CMP     R0,#KSPC
        BNE     1$
        JMP     GAME
1$:     CMP     R0,#KQ
        BNE     DEMO
        JMP     KQUIT
DEMO:   MOV     #1,MODE
        JSR     PC,NEWGAM
        MOV     #MDEMO,MSG
2$:     JSR     PC,REDRAW
        CLR     R0
        JSR     PC,AITURN
        TST     DEMOKY
        BNE     4$
        TST     GSTATE
        BNE     3$
        MOV     #COWN,R0
        JSR     PC,AITURN
        TST     DEMOKY
        BNE     4$
        TST     GSTATE
        BNE     3$
        INC     ROUND
        BR      2$
3$:     JSR     PC,REDRAW       ; over: a moment, then the title again
        MOV     #150.,R0
        JSR     PC,DWAIT
        TST     DEMOKY
        BNE     4$
        JMP     TITLE
4$:     MOV     DEMOKY,R0
        CLR     DEMOKY
        CMP     R0,#KQ
        BNE     GAME
        JMP     KQUIT
GAME:   MOV     #2,MODE
        JSR     PC,NEWGAM
        JSR     PC,KFLUSH
        JSR     PC,REDRAW
MLOOP:  JSR     PC,KEY
        TST     R0
        BEQ     MLOOP
        JSR     PC,ONKEY
        BR      MLOOP

; DWAIT: R0 frames, the keys watched meanwhile.  At the title and in the
; demo SPACE or Q ends the wait and is left in DEMOKY; in the game the
; keys pressed while the computer moves are dropped.
DWAIT:  MOV     R0,DWCNT
1$:     MOV     #1,R0
        JSR     PC,WAIT
        JSR     PC,KEY
        TST     R0
        BEQ     2$
        CMP     MODE,#2
        BEQ     2$
        CMP     R0,#KSPC
        BEQ     3$
        CMP     R0,#KQ
        BNE     2$
3$:     MOV     R0,DEMOKY
        RTS     PC
2$:     DEC     DWCNT
        BNE     1$
        RTS     PC
DWCNT:  .WORD   0

; ONKEY: R0 = a key's code; the handler of a key of ours, or nothing.
ONKEY:  MOV     #KEYTAB,R1
1$:     MOV     (R1)+,R2
        BEQ     9$
        CMP     R0,R2
        BEQ     2$
        TST     (R1)+
        BR      1$
2$:     JMP     @(R1)+
9$:     RTS     PC
KEYTAB: .WORD   KTAB,KTABK, KSPC,KSPCK
        .WORD   KUP,KUPK, KDOWN,KDOWNK, KLEFT,KLEFTK, KRIGHT,KRGHTK
        .WORD   KS,KSAVEK, KL,KLOADK, KQ,KQUIT, KN,KNEW
        .WORD   0

KQUIT:  JSR     PC,HWEXIT
        .EXIT

KNEW:   TST     GSTATE          ; a new game once this one is over
        BEQ     1$
        JSR     PC,NEWGAM
        JSR     PC,REDRAW
1$:     RTS     PC

; TAB: the next unmoved unit - the combat units round and round, then
; the factories.
KTABK:  TST     SEL
        BMI     1$
        JSR     PC,NEXTSL
        JSR     PC,REDRAW
1$:     RTS     PC

; The arrows: the cursor a step from the selected unit, no further.
KUPK:   TST     SEL
        BMI     1$
        CMP     CDY,#-1
        BLE     1$
        DEC     CDY
        JSR     PC,REDRAW
1$:     RTS     PC
KDOWNK: TST     SEL
        BMI     1$
        CMP     CDY,#1
        BGE     1$
        INC     CDY
        JSR     PC,REDRAW
1$:     RTS     PC
KLEFTK: TST     SEL
        BMI     1$
        CMP     CDX,#-1
        BLE     1$
        DEC     CDX
        JSR     PC,REDRAW
1$:     RTS     PC
KRGHTK: TST     SEL
        BMI     1$
        CMP     CDX,#1
        BGE     1$
        INC     CDX
        JSR     PC,REDRAW
1$:     RTS     PC

; SPACE: the selected unit's move to the cursor's cell.
KSPCK:  TST     SEL
        BMI     1$
        JSR     PC,DOMOVE
1$:     RTS     PC

KSAVEK: TST     SEL             ; between moves of the human's turn
        BMI     1$
        JSR     PC,SAVE
        JSR     PC,REDRAW
1$:     RTS     PC

KLOADK: JSR     PC,LOAD
        JSR     PC,REDRAW
        RTS     PC

; --- the human's move -----------------------------------------------------
DOMOVE: MOV     SEL,R0
        JSR     PC,TARGET
        JSR     PC,MOVKND
        JSR     PC,APPLY
        BCC     1$
        MOV     #MINVAL,MSG
        JSR     PC,CLICK
        JSR     PC,REDRAW
        RTS     PC
1$:     JSR     PC,PLAYK
        JSR     PC,AFTMOV
        RTS     PC

; MOVKND: R0, R1 = a move about to be applied; MKIND = what it is: 0 a
; step, 1 a blow, 2 standing, 3 a unit made.  Keeps R0 and R1.
MOVKND: MOV     #2,MKIND
        CMP     R0,R1
        BEQ     9$
        MOV     #3,MKIND
        MOVB    BOARD(R0),R2
        BIC     #^C<CSTG>,R2
        CMP     R2,#SFACT
        BEQ     9$
        MOV     #1,MKIND
        TSTB    BOARD(R1)
        BMI     9$
        CLR     MKIND
9$:     RTS     PC
MKIND:  .WORD   0

; PLAYK: the sound of the move MKIND names.  Keeps R0 and R1.
PLAYK:  MOV     R0,-(SP)
        MOV     R1,-(SP)
        MOV     MKIND,R0
        ASL     R0
        JSR     PC,@SNDTAB(R0)
        MOV     (SP)+,R1
        MOV     (SP)+,R0
        RTS     PC
SNDTAB: .WORD   SNDMOV,SNDHIT,SNDSTD,SNDNEW

; TARGET: R1 = the cursor's cell, SEL + dy * 24 + dx.  Keeps R0.
TARGET: MOV     CDY,R1
        ASL     R1
        ASL     R1
        ASL     R1
        MOV     R1,R2
        ASL     R1
        ADD     R2,R1
        ADD     CDX,R1
        ADD     SEL,R1
        RTS     PC

; AFTMOV: after a move applied from R0 to R1 - the view widened round
; both cells, the game checked for its end, the next unit selected; when
; none is left the computer plays and a new round begins.
AFTMOV: MOV     R1,-(SP)
        JSR     PC,VISADD
        MOV     (SP)+,R0
        JSR     PC,VISADD
        JSR     PC,WINCHK
        TST     GSTATE
        BNE     8$
        JSR     PC,NEXTSL
        TST     R0
        BPL     7$
        JSR     PC,CPUTRN
        TST     GSTATE
        BNE     8$
7$:     JSR     PC,REDRAW
        RTS     PC
8$:     MOV     #-1,SEL
        JSR     PC,REDRAW
        RTS     PC

; --- the rules: APPLY ---------------------------------------------------
; R0 = the cell of the unit that moves, R1 = the cell it steps to (R0
; itself to stand).  Applies the move to the board and returns with C
; clear, or refuses it with C set and the board untouched.  Keeps R0
; and R1.
APPLY:  MOVB    BOARD(R0),R2    ; R2 = the unit
        BIC     #177400,R2
        CMP     R0,R1
        BEQ     50$
        MOVB    BOARD(R1),R3    ; R3 = what is at the target
        BIC     #177400,R3
        MOV     R2,R4
        BIC     #^C<CSTG>,R4
        CMP     R4,#SFACT
        BNE     10$
        TST     R3              ; a factory builds on an empty cell only
        BNE     90$
        MOV     R2,R4
        BIC     #^C<COWN>,R4
        BIS     #CUNIT+CMOVD,R4
        MOVB    R4,BOARD(R1)    ; the new infantry, moved already
        BIS     #1,R4
        MOVB    R4,BOARD(R0)    ; the factory spent: fortification 1
        BR      80$
10$:    MOV     R2,R4           ; a combat unit steps as an infantry
        BIC     #^C<COWN>,R4
        BIS     #CUNIT+CMOVD,R4 ; R4 = the mover as it will be
        TST     R3
        BNE     20$
        MOVB    R4,BOARD(R1)    ; an empty cell: it moves there
        CLRB    BOARD(R0)
        BR      80$
20$:    BIT     #CUNIT,R3       ; off the map
        BEQ     90$
        MOV     R2,R5
        XOR     R3,R5
        BIT     #COWN,R5        ; its own: no
        BEQ     90$
        MOV     R3,R5
        BIC     #^C<CSTG>,R5
        CMP     R5,#1
        BEQ     30$
        CMP     R5,#2
        BEQ     30$
        MOVB    R4,BOARD(R1)    ; an infantry or a factory: killed, the
        CLRB    BOARD(R0)       ;   cell taken
        BR      80$
30$:    CLRB    BOARD(R0)       ; a fortification: the attacker dies and
        BICB    #CSTG,BOARD(R1) ;   the fortification is an infantry now
        BR      80$
50$:    MOV     R2,R4           ; standing: a stage up, a factory stays
        BIC     #^C<CSTG>,R4
        CMP     R4,#SFACT
        BEQ     51$
        INC     R2
51$:    BIS     #CMOVD,R2
        MOVB    R2,BOARD(R0)
80$:    CLC
        RTS     PC
90$:    SEC
        RTS     PC

; --- the turn --------------------------------------------------------------
; BEGTRN: R0 = the player (0 or COWN) whose turn begins: their units
; unmoved, their view drawn afresh round each, their first unit selected.
BEGTRN: MOV     R0,TURN
        CLR     PHASE
        MOV     #VISH,VISP
        TST     R0
        BEQ     1$
        MOV     #VISC,VISP
1$:     MOV     VISP,R1
        MOV     #NCELLS,R2
2$:     CLRB    (R1)+
        SOB     R2,2$
        CLR     R0
        MOV     #NCELLS,R2
3$:     MOVB    BOARD(R0),R1
        BPL     4$
        BIC     #^C<COWN>,R1
        CMP     R1,TURN
        BNE     4$
        BICB    #CMOVD,BOARD(R0)
        JSR     PC,VISADD
4$:     INC     R0
        SOB     R2,3$
        MOV     #-1,SEL
        JSR     PC,NEXTSL
        RTS     PC

; NEXTSL: the next unmoved unit of the player whose turn it is, scanning
; on from SEL round the board: in PHASE 0 a combat unit, in PHASE 1 a
; factory.  When phase 0 has none left it becomes phase 1; when that has
; none the turn is over.  R0 = SEL = the cell, or -1; the cursor on it.
NEXTSL: MOV     SEL,R0
        INC     R0
1$:     MOV     #NCELLS,R2
2$:     CMP     R0,#NCELLS
        BLO     3$
        CLR     R0
3$:     MOVB    BOARD(R0),R1
        BPL     5$
        BIT     #CMOVD,R1
        BNE     5$
        MOV     R1,R3
        BIC     #^C<COWN>,R3
        CMP     R3,TURN
        BNE     5$
        BIC     #^C<CSTG>,R1
        CMP     R1,#SFACT
        BEQ     4$
        TST     PHASE           ; a combat unit: wanted in phase 0
        BNE     5$
        BR      6$
4$:     TST     PHASE           ; a factory: wanted in phase 1
        BEQ     5$
6$:     MOV     R0,SEL
        CLR     CDX
        CLR     CDY
        RTS     PC
5$:     INC     R0
        SOB     R2,2$
        TST     PHASE           ; none: on to the factories, once
        BNE     7$
        INC     PHASE
        CLR     R0
        BR      1$
7$:     MOV     #-1,R0
        MOV     R0,SEL
        RTS     PC

; VISADD: R0 = a cell; when a unit of the player whose turn it is stands
; there, the cells within its radius (1, or 2 for a fortification) go
; into that player's view.  Keeps every register.
VISADD: MOV     R1,-(SP)
        MOV     R2,-(SP)
        MOV     R3,-(SP)
        MOV     R4,-(SP)
        MOV     R5,-(SP)
        MOVB    BOARD(R0),R1
        BPL     9$
        BIC     #^C<COWN>,R1
        CMP     R1,TURN
        BNE     9$
        MOVB    BOARD(R0),R1
        BIC     #^C<CSTG>,R1
        MOV     #1,R2           ; R2 = the radius
        CMP     R1,#1
        BLO     1$
        CMP     R1,#2
        BHI     1$
        MOV     #2,R2
1$:     MOV     R2,R3           ; R3 = dy, from -r to r
        NEG     R3
2$:     MOV     R3,R1           ; the row's first cell: R0 + dy * 24 - r
        ASL     R1
        ASL     R1
        ASL     R1
        MOV     R1,R4
        ASL     R1
        ADD     R4,R1
        ADD     R0,R1
        SUB     R2,R1
        MOV     R2,R4           ; 2r + 1 cells along it
        ASL     R4
        INC     R4
3$:     CMPB    BOARD(R1),#CEDGE
        BEQ     4$
        MOV     R1,R5
        ADD     VISP,R5
        MOVB    #1,(R5)
4$:     INC     R1
        SOB     R4,3$
        INC     R3
        CMP     R3,R2
        BLE     2$
9$:     MOV     (SP)+,R5
        MOV     (SP)+,R4
        MOV     (SP)+,R3
        MOV     (SP)+,R2
        MOV     (SP)+,R1
        RTS     PC

; WINCHK: the units counted, HCNT and CCNT; the game over when a side
; has none - GSTATE 1 the human wins, 2 the computer.
WINCHK: CLR     HCNT
        CLR     CCNT
        MOV     #NCELLS,R1
        MOV     #BOARD,R2
1$:     MOVB    (R2)+,R0
        BPL     2$
        BIT     #COWN,R0
        BNE     3$
        INC     HCNT
        BR      2$
3$:     INC     CCNT
2$:     SOB     R1,1$
        TST     CCNT
        BNE     4$
        MOV     #1,GSTATE
        MOV     #MWIN,MSG
        RTS     PC
4$:     TST     HCNT
        BNE     5$
        MOV     #2,GSTATE
        MOV     #MLOSE,MSG
5$:     RTS     PC

; --- the computer's turn -------------------------------------------------
; CPUTRN: the computer plays its side; then the round is over and the
; human's turn begins, the keys pressed meanwhile forgotten.
CPUTRN: MOV     #MCPU,MSG
        JSR     PC,REDRAW
        MOV     #COWN,R0
        JSR     PC,AITURN
        TST     GSTATE
        BNE     1$
        INC     ROUND
        CLR     R0
        JSR     PC,BEGTRN
        MOV     #MYOUR,MSG
        JSR     PC,KFLUSH
1$:     RTS     PC

; AITURN: R0 = a side (0 or COWN); the computer moves every unit of it,
; each as AIMOVE chooses, shown as it goes (PREMOV, POSTMV).  In the demo
; a key that ends it (DEMOKY) ends the turn too.
AITURN: MOV     R0,AIOWN
        CLR     AIMIDX
        TST     R0
        BEQ     1$
        MOV     #2,AIMIDX
1$:     JSR     PC,BEGTRN
2$:     TST     SEL
        BMI     9$
        MOV     SEL,R0
        JSR     PC,AIMOVE       ; R1 = the cell it chooses
        MOV     SEL,R0
        JSR     PC,PREMOV
        JSR     PC,MOVKND
        JSR     PC,APPLY
        BCC     3$
        MOV     SEL,R0          ; a choice the rules refuse: it stands
        MOV     R0,R1
        JSR     PC,MOVKND
        JSR     PC,APPLY
3$:     JSR     PC,VISADD       ; both cells into its view (VISADD keeps
        MOV     R0,-(SP)        ;   every register)
        MOV     R1,R0
        JSR     PC,VISADD
        MOV     (SP)+,R0
        JSR     PC,POSTMV
        JSR     PC,WINCHK
        TST     GSTATE
        BNE     9$
        CMP     MODE,#1
        BNE     4$
        TST     DEMOKY
        BNE     9$
4$:     JSR     PC,NEXTSL
        BR      2$
9$:     RTS     PC

; PREMOV: R0, R1 = the two cells of the computer's move, about to be
; made.  When the human sees either (in the demo, always) the unit is
; shown on white for a moment, then the cell it goes to on yellow.
; Keeps R0 and R1; PMSEEN says whether it was shown.
PREMOV: MOV     R0,PMSRC
        MOV     R1,PMDST
        CLR     PMSEEN
        CMP     MODE,#2
        BNE     1$
        TSTB    VISH(R0)
        BNE     1$
        TSTB    VISH(R1)
        BEQ     9$
1$:     MOV     #1,PMSEEN
        MOV     PMSRC,HILITE
        JSR     PC,REDRAW
        MOV     #8.,R0
        JSR     PC,DWAIT
        CMP     PMSRC,PMDST
        BEQ     9$
        MOV     PMDST,HILIT2
        JSR     PC,REDRAW
        MOV     #8.,R0
        JSR     PC,DWAIT
9$:     MOV     PMSRC,R0
        MOV     PMDST,R1
        RTS     PC

; POSTMV: the move made - its sound, and a blow flashes the cell it
; landed on.  Keeps R0 and R1.
POSTMV: MOV     R0,-(SP)
        MOV     R1,-(SP)
        MOV     #-1,HILITE
        MOV     #-1,HILIT2
        TST     PMSEEN
        BEQ     9$
        JSR     PC,REDRAW
        JSR     PC,PLAYK
        CMP     MKIND,#1
        BNE     8$
        MOV     #2,R1
1$:     MOV     R1,-(SP)
        MOV     PMDST,FLASHC
        JSR     PC,REDRAW
        MOV     #3,R0
        JSR     PC,DWAIT
        MOV     #-1,FLASHC
        JSR     PC,REDRAW
        MOV     #3,R0
        JSR     PC,DWAIT
        MOV     (SP)+,R1
        SOB     R1,1$
8$:     MOV     #6,R0
        JSR     PC,DWAIT
9$:     MOV     (SP)+,R1
        MOV     (SP)+,R0
        RTS     PC
PMSRC:  .WORD   0
PMDST:  .WORD   0
PMSEEN: .WORD   0
HILITE: .WORD   -1              ; the cells shown on white, yellow, red
HILIT2: .WORD   -1
FLASHC: .WORD   -1


; --- the computer's play ----------------------------------------------------
; The computer sees what its units see (the view of the side it plays,
; VISP) and nothing else, and chooses for each unit in turn the step that
; scores best of the nine.  AIOWN is the side it plays (0 or COWN: in
; the demo it plays both), AIMIDX that side's word in AIMEM and HOMES.
; The scores, in decimal:
SKFAC  = 120.                   ; killing a factory
SKINF  = 80.                    ; killing an infantry
SKDANG = 20.                    ; less, for each enemy that can strike the killer
SKDNGL = 6.                     ;   - less by half the pressure, this at least
SHITP  = 50.                    ; hitting a fortification with a partner next
                                ;   to it to finish it off
SHITA  = -100.                  ; hitting one alone: the attacker dies for nothing
SDANG  = 35.                    ; a step next to an enemy combat unit: it strikes
SDANGL = 12.                    ;   first - less by half the pressure, this at least
SAPPR  = 12.                    ; a step nearer the goal
SFACN  = 30.                    ; a step next to an enemy factory: the kill comes next
SROOM  = 15.                    ; a step next to an own factory: it needs room to build
SSTAY0 = 10.                    ; standing as an infantry
SSTAY1 = 14.                    ; standing as fortification 1
SSTAY2 = 18.                    ; standing as fortification 2: a factory, with no
SFACNR = -40.                   ;   enemy within SNEAR; and with one
SGUARD = 25.                    ; standing with one enemy next door: the
                                ;   fortification takes the hit
SQUIET = 15.                    ; standing with no enemy in view, when the side
NBUILD = 2                      ;   has fewer builders than this (a builder is a
                                ;   unit past the infantry): the economy
SGO    = 10.                    ; standing with no enemy in view otherwise: the
                                ;   army marches on the enemy's start
SPRESS = 3.                     ; the pressure: per unit above four, the army goes
SPRMAX = 30.                    ;   to war as it grows, this much at most - a step
                                ;   forward gains it, the fear of an enemy loses it
SCROWD = 5.                     ; standing in a crowd: per own neighbour above
                                ;   three; and a unit made among own neighbours
SPROD  = 10.                    ; a factory building
SPRODD = 10.                    ; less, per enemy next to the new unit
SFSTAY = -10.                   ; a factory standing instead
SNEAR  = 3                      ; "near": within this many cells
SFAR   = 5                      ; "in view" for a unit: an enemy seen within this

; AIMOVE: R0 = the cell of a unit of the computer's; R1 = the cell it
; steps to (R0 to stand).
AIMOVE: MOV     R0,AIC
        MOVB    BOARD(R0),R1
        BIC     #^C<CSTG>,R1
        MOV     R1,AIS          ; the stage
        JSR     PC,GOAL         ; AIG = where to go, AIGK = an enemy in view
        MOV     AIC,R0
        MOV     #PENEMY,R2
        JSR     PC,NBSCAN
        MOV     R0,AIDNG        ; enemies next to the unit
        JSR     PC,ARMY         ; AINF, AIBLD: the side's infantry and builders
        CLR     AIPRSS          ; the army's pressure: SPRESS a unit above four
        MOV     AINF,R0
        ADD     AIBLD,R0
        SUB     #4,R0
        BLE     1$
        MOV     R0,R1
        ADD     R0,R0
        ADD     R1,R0
        CMP     R0,#SPRMAX
        BLE     2$
        MOV     #SPRMAX,R0
2$:     MOV     R0,AIPRSS
1$:     MOV     #-32000.,AIBEST
        MOV     AIC,AIBT
        JSR     PC,SCSTAY
        MOV     AIC,R1
        JSR     PC,BETTER
        CLR     AINB
3$:     MOV     AINB,R1
        MOV     AIC,R0
        ADD     NBOFF(R1),R0
        MOV     R0,AIT
        JSR     PC,SCSTEP
        BCS     4$
        MOV     AIT,R1
        JSR     PC,BETTER
4$:     ADD     #2,AINB
        CMP     AINB,#16.
        BLO     3$
        MOV     AIBT,R1
        RTS     PC

; BETTER: R0 = a score, R1 = the step it is for; kept when it beats the
; best so far, a little chance thrown in.
BETTER: MOV     SEED,R2         ; the next of the sequence: seed * 5 + 1
        ASL     R2
        ASL     R2
        ADD     SEED,R2
        INC     R2
        MOV     R2,SEED
        SWAB    R2
        BIC     #^C7,R2
        ADD     R2,R0
        CMP     R0,AIBEST
        BLE     1$
        MOV     R0,AIBEST
        MOV     R1,AIBT
1$:     RTS     PC

; ARMY: AINF = the side's infantry, AIBLD = its builders (the units past
; the infantry: they are on their way to a factory, or are one).
ARMY:   CLR     AINF
        CLR     AIBLD
        MOV     #NCELLS,R2
        CLR     R1
1$:     MOV     R1,R0
        JSR     PC,OWNU
        TST     R0
        BEQ     3$
        MOVB    BOARD(R1),R0
        BIC     #^C<CSTG>,R0
        BNE     2$
        INC     AINF
        BR      3$
2$:     INC     AIBLD
3$:     INC     R1
        SOB     R2,1$
        RTS     PC

; SCSTAY: R0 = the score of standing.
SCSTAY: MOV     AIS,R0
        CMP     R0,#SFACT
        BNE     1$
        MOV     #SFSTAY,R0      ; a factory has nothing to gain by it
        RTS     PC
1$:     ASL     R0
        MOV     STAYS(R0),R0
        CMP     AIS,#2
        BNE     2$
        MOV     R0,-(SP)        ; a factory next: not with an enemy near
        MOV     AIC,R0
        MOV     #SNEAR,R1
        JSR     PC,SEENNR
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     2$
        MOV     #SFACNR,R0
2$:     CMP     AIDNG,#1
        BNE     3$
        CMP     AIS,#2
        BHIS    3$
        ADD     #SGUARD,R0
3$:     MOV     AIBLD,R1        ; the economy needs a few builders, the war
        TST     AIS             ;   the rest
        BNE     5$
        MOV     R0,-(SP)        ; an infantry with no enemy near: one more
        MOV     AIC,R0          ;   builder wanted, or off to war
        MOV     #SFAR,R1
        JSR     PC,SEENNR
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BNE     6$
        CMP     AIBLD,#NBUILD
        BLT     4$
        SUB     #SGO,R0
        BR      6$
5$:     CMP     R1,#NBUILD+1    ; a builder keeps building, an enemy near or
        BGT     6$              ;   not, unless the side has one too many
4$:     ADD     #SQUIET,R0
6$:     MOV     R0,-(SP)        ; in a crowd of its own: out of it
        MOV     AIC,R0
        MOV     #OWNU,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        SUB     #3,R1
        BLE     7$
8$:     SUB     #SCROWD,R0
        SOB     R1,8$
7$:     RTS     PC
STAYS:  .WORD   SSTAY0,SSTAY1,SSTAY2

; SCSTEP: R0 = the score of the step to AIT, or C set when the rules
; refuse it.
SCSTEP: MOV     AIT,R1
        MOVB    BOARD(R1),R2
        BIC     #177400,R2
        CMP     R2,#CEDGE
        BNE     5$
        SEC                     ; off the map
        RTS     PC
5$:     CMP     AIS,#SFACT
        BNE     10$
        JMP     SCFAC           ; a factory's step is another matter
10$:    TST     R2
        BNE     20$
        JSR     PC,APPRCH       ; an empty cell: nearer the goal, or not
        MOV     R0,R1
        ASL     R0
        ASL     R0
        ASL     R0
        TST     R1
        BLE     11$
        ADD     AIPRSS,R0
11$:    MOV     R0,-(SP)
        MOV     AIT,R0
        MOV     #PENEMY,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     13$
        MOV     R2,-(SP)        ; the danger, less by half the pressure
        MOV     #SDANG,R2
        MOV     AIPRSS,-(SP)
        ASR     (SP)
        SUB     (SP)+,R2
        CMP     R2,#SDANGL
        BGE     12$
        MOV     #SDANGL,R2
12$:    SUB     R2,R0
        SOB     R1,12$
        MOV     (SP)+,R2
13$:    MOV     R0,-(SP)
        MOV     AIT,R0
        MOV     #PEFAC,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     14$
        ADD     #SFACN,R0
14$:    MOV     R0,-(SP)
        MOV     AIT,R0
        MOV     #POWNF,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     80$
        SUB     #SROOM,R0
        BR      80$
20$:    BIT     #COWN,R2        ; a unit: its own is no step
        BNE     90$
        BIC     #^C<CSTG>,R2
        CMP     R2,#1
        BEQ     30$
        CMP     R2,#2
        BEQ     30$
        MOV     #SKINF,R0       ; an infantry or a factory: killed
        CMP     R2,#SFACT
        BNE     21$
        MOV     #SKFAC,R0
21$:    MOV     R0,-(SP)
        MOV     AIT,R0
        MOV     #PENEMY,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     80$
        MOV     #SKDANG,R2      ; less by half the pressure
        MOV     AIPRSS,-(SP)
        ASR     (SP)
        SUB     (SP)+,R2
        CMP     R2,#SKDNGL
        BGE     22$
        MOV     #SKDNGL,R2
22$:    SUB     R2,R0
        SOB     R1,22$
        BR      80$
30$:    MOV     AIC,PSELF       ; a fortification: only with a partner
        MOV     AIT,R0
        MOV     #PPART,R2
        JSR     PC,NBSCAN
        TST     R0
        BNE     31$
        MOV     #SHITA,R0
        BR      80$
31$:    MOV     #SHITP,R0
80$:    CLC
        RTS     PC
90$:    SEC
        RTS     PC

; SCFAC: the step of a factory - building on an empty cell: R0 = its
; score, or C set for a cell that is not empty.  R2 = what is at AIT.
SCFAC:  TST     R2
        BNE     90$
        JSR     PC,APPRCH       ; nearer the goal, three a step
        MOV     R0,R1
        ADD     R0,R0
        ADD     R1,R0
        ADD     #SPROD,R0
        MOV     R0,-(SP)
        MOV     AIT,R0
        MOV     #PENEMY,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     2$
1$:     SUB     #SPRODD,R0      ; less for each enemy the new unit would face
        SOB     R1,1$
2$:     MOV     R0,-(SP)        ; and for each own neighbour: out of the crowd
        MOV     AIT,R0
        MOV     #OWNU,R2
        JSR     PC,NBSCAN
        MOV     R0,R1
        MOV     (SP)+,R0
        TST     R1
        BEQ     80$
3$:     SUB     #SCROWD,R0
        SOB     R1,3$
80$:    CLC
        RTS     PC
90$:    SEC
        RTS     PC

; APPRCH: R0 = how much nearer the goal AIT is than AIC: 1, 0 or -1.
APPRCH: MOV     AIC,R0
        MOV     AIG,R1
        JSR     PC,DIST
        MOV     R0,-(SP)
        MOV     AIT,R0
        MOV     AIG,R1
        JSR     PC,DIST
        MOV     (SP)+,R1
        SUB     R0,R1
        MOV     R1,R0
        RTS     PC

; GOAL: AIG = the nearest enemy in view of AIC, remembered in AIMEM; or
; the one last seen; or the human's corner of the board.  AIGK = 1 when
; an enemy is in view.
GOAL:   MOV     AIMIDX,R2
        MOV     HOMES(R2),AIG
        CLR     AIGK
        MOV     #-1,R4          ; R4 = the nearest so far, R5 = its distance
        MOV     #100.,R5
        CLR     R3
1$:     MOV     R3,R0
        JSR     PC,ENEMY
        TST     R0
        BEQ     2$
        MOV     AIC,R0
        MOV     R3,R1
        JSR     PC,DIST
        CMP     R0,R5
        BHIS    2$
        MOV     R0,R5
        MOV     R3,R4
2$:     INC     R3
        CMP     R3,#NCELLS
        BLO     1$
        MOV     AIMIDX,R2
        TST     R4
        BMI     3$
        MOV     R4,AIG
        MOV     R4,AIMEM(R2)
        MOV     #1,AIGK
        RTS     PC
3$:     TST     AIMEM(R2)
        BMI     4$
        MOV     AIMEM(R2),AIG
4$:     RTS     PC
HOMES:  .WORD   CELL0+<5*PW>+15.,CELL0+<4*PW>+4   ; the other side's start

; ENEMY: R0 = a cell; R0 = 1 when an enemy unit in view stands there.
; Keeps R1.
ENEMY:  MOV     R2,-(SP)
        MOV     VISP,R2
        ADD     R0,R2
        TSTB    (R2)
        BEQ     9$
        MOVB    BOARD(R0),R2
        BPL     9$
        BIC     #^C<COWN>,R2
        CMP     R2,AIOWN
        BEQ     9$
        MOV     #1,R0
        MOV     (SP)+,R2
        RTS     PC
9$:     CLR     R0
        MOV     (SP)+,R2
        RTS     PC

; SEENNR: R0 = a cell, R1 = a distance; R0 = 1 when an enemy in view is
; within that distance of the cell.
SEENNR: MOV     R0,R4
        MOV     R1,R5
        CLR     R3
1$:     MOV     R3,R0
        JSR     PC,ENEMY
        TST     R0
        BEQ     2$
        MOV     R4,R0
        MOV     R3,R1
        JSR     PC,DIST
        CMP     R0,R5
        BLOS    3$
2$:     INC     R3
        CMP     R3,#NCELLS
        BLO     1$
        CLR     R0
        RTS     PC
3$:     MOV     #1,R0
        RTS     PC

; DIST: R0, R1 = two cells; R0 = the distance between them, the larger
; of the two along the axes (a step covers one of each).
DIST:   MOV     R3,-(SP)
        MOVB    XTAB(R0),R2
        MOVB    XTAB(R1),R3
        SUB     R3,R2
        BPL     1$
        NEG     R2
1$:     MOVB    YTAB(R0),R0
        MOVB    YTAB(R1),R1
        SUB     R1,R0
        BPL     2$
        NEG     R0
2$:     CMP     R0,R2
        BHIS    3$
        MOV     R2,R0
3$:     MOV     (SP)+,R3
        RTS     PC

; NBSCAN: R0 = a cell, R2 = a test; R0 = how many of the cell's eight
; neighbours pass it.  A test gets the neighbour in R0 and answers 0 or 1
; in R0; it may use R1 and R2.
NBSCAN: MOV     R0,NBCELL
        MOV     R2,NBPRED
        CLR     NBSUM
        CLR     NBI
1$:     MOV     NBI,R1
        MOV     NBCELL,R0
        ADD     NBOFF(R1),R0
        JSR     PC,@NBPRED
        ADD     R0,NBSUM
        ADD     #2,NBI
        CMP     NBI,#16.
        BLO     1$
        MOV     NBSUM,R0
        RTS     PC
NBOFF:  .WORD   -PW-1,-PW,-PW+1,-1,1,PW-1,PW,PW+1
NBCELL: .WORD   0
NBPRED: .WORD   0
NBSUM:  .WORD   0
NBI:    .WORD   0

; PENEMY: an enemy combat unit in view.
PENEMY: MOV     R0,R1
        JSR     PC,ENEMY
        TST     R0
        BEQ     9$
        MOVB    BOARD(R1),R1
        BIC     #^C<CSTG>,R1
        CMP     R1,#SFACT
        BEQ     9$
        MOV     #1,R0
        RTS     PC
9$:     CLR     R0
        RTS     PC

; PEFAC: an enemy factory in view.
PEFAC:  MOV     R0,R1
        JSR     PC,ENEMY
        TST     R0
        BEQ     9$
        MOVB    BOARD(R1),R1
        BIC     #^C<CSTG>,R1
        CMP     R1,#SFACT
        BNE     9$
        MOV     #1,R0
        RTS     PC
9$:     CLR     R0
        RTS     PC

; OWNU: R0 = a cell; R0 = 1 when a unit of the side the computer plays
; stands there.  Keeps R1.
OWNU:   MOVB    BOARD(R0),R2
        BPL     9$
        BIC     #^C<COWN>,R2
        CMP     R2,AIOWN
        BNE     9$
        MOV     #1,R0
        RTS     PC
9$:     CLR     R0
        RTS     PC

; POWNF: a factory of the side's own.
POWNF:  MOV     R0,R1
        JSR     PC,OWNU
        TST     R0
        BEQ     9$
        MOVB    BOARD(R1),R1
        BIC     #^C<CSTG>,R1
        CMP     R1,#SFACT
        BNE     9$
        MOV     #1,R0
        RTS     PC
9$:     CLR     R0
        RTS     PC

; PPART: a combat unit of the side's own with its move still to make,
; other than the one at PSELF.
PPART:  CMP     R0,PSELF
        BEQ     9$
        MOV     R0,R1
        JSR     PC,OWNU
        TST     R0
        BEQ     9$
        MOVB    BOARD(R1),R1
        BIT     #CMOVD,R1
        BNE     9$
        BIC     #^C<CSTG>,R1
        CMP     R1,#SFACT
        BEQ     9$
        MOV     #1,R0
        RTS     PC
9$:     CLR     R0
        RTS     PC
PSELF:  .WORD   0

AIOWN:  .WORD   0               ; the side the computer plays
AIMIDX: .WORD   0               ;   and its word in AIMEM and HOMES
AIC:    .WORD   0               ; the unit's cell
AIS:    .WORD   0               ; its stage
AIT:    .WORD   0               ; the step under consideration
AIG:    .WORD   0               ; the goal
AIGK:   .WORD   0               ; an enemy is in view
AIDNG:  .WORD   0               ; enemies next to the unit
AIPRSS: .WORD   0               ; the pressure forward
AINF:   .WORD   0               ; the side's infantry
AIBLD:  .WORD   0               ; the side's builders
AIBEST: .WORD   0               ; the best score so far
AIBT:   .WORD   0               ;   and its step
AINB:   .WORD   0

; XYINIT: XTAB and YTAB, a cell's column and row by its index.
XYINIT: CLR     R0
        CLR     R1              ; R1 = x, R2 = y
        CLR     R2
1$:     MOVB    R1,XTAB(R0)
        MOVB    R2,YTAB(R0)
        INC     R1
        CMP     R1,#PW
        BLO     2$
        CLR     R1
        INC     R2
2$:     INC     R0
        CMP     R0,#NCELLS
        BLO     1$
        RTS     PC
XTAB:   .BLKB   NCELLS
YTAB:   .BLKB   NCELLS

; --- a new game --------------------------------------------------------------
NEWGAM: MOV     #BOARD,R1       ; the frame all round
        MOV     #NCELLS,R2
1$:     MOVB    #CEDGE,(R1)+
        SOB     R2,1$
        MOV     #BOARD+CELL0,R1 ; the map empty
        MOV     #HEIGHT,R2
2$:     MOV     R1,R0
        MOV     #WIDTH,R3
3$:     CLRB    (R0)+
        SOB     R3,3$
        ADD     #PW,R1
        SOB     R2,2$
        MOVB    #CUNIT+2,BOARD+CELL0+<4*PW>+4          ; the human's fortification 2 at (4,4)
        MOVB    #CUNIT+COWN+2,BOARD+CELL0+<5*PW>+15.   ; the computer's at (15,5)
        MOV     #1,ROUND
        CLR     GSTATE
        MOV     FRAMES,SEED
        MOV     #-1,AIMEM       ; neither side has seen anything yet
        MOV     #-1,AIMEM+2
        MOV     #-1,HILITE
        MOV     #-1,HILIT2
        MOV     #-1,FLASHC
        MOV     #MYOUR,MSG
        JSR     PC,WINCHK
        CLR     R0
        JSR     PC,BEGTRN
        RTS     PC

; --- the screen -----------------------------------------------------------------
; REDRAW: the whole board and the lines under it.
REDRAW: MOV     #-1,CURIDX      ; the cursor's cell, for DRAWCL
        TST     SEL
        BMI     1$
        JSR     PC,TARGET
        MOV     R1,CURIDX
1$:     CLR     R5              ; R5 = the row, R4 = the column
2$:     CLR     R4
3$:     MOV     R4,R0
        MOV     R5,R1
        JSR     PC,DRAWCL
        INC     R4
        CMP     R4,#WIDTH
        BLO     3$
        INC     R5
        CMP     R5,#HEIGHT
        BLO     2$
        JSR     PC,STATUS
        RTS     PC

; DRAWCL: the cell at column R0, row R1 - the fog, an empty cell, or a
; unit in its owner's colour, bright while it has a move to make; the
; grid closed on the right and below where the view ends; the selected
; unit on blue, the highlights, the cursor's cell flashing.
DRAWCL: MOV     R0,-(SP)
        MOV     R1,-(SP)
        MOV     R1,R2           ; R2 = CELL0 + y * 24 + x
        ASL     R2
        ASL     R2
        ASL     R2
        MOV     R2,R1
        ASL     R1
        ADD     R1,R2
        ADD     R0,R2
        ADD     #CELL0,R2
        MOV     #TFOG,TILE
        MOVB    #AFOG,TATTR
        MOV     R2,R0
        JSR     PC,SHOWN
        TST     R0
        BEQ     7$
        MOV     #TEMPTY,TILE
        MOVB    #AEMP,TATTR
        MOVB    BOARD(R2),R1
        BPL     3$
        MOV     R1,R0
        BIC     #^C<CSTG>,R0
        ASL     R0
        MOV     TILES(R0),TILE
        MOV     #AHUM,R0
        BIT     #COWN,R1
        BEQ     4$
        MOV     #ACPU,R0
4$:     BIT     #CMOVD,R1
        BNE     5$
        BIS     #ABRT,R0
5$:     MOVB    R0,TATTR
3$:     CLR     R1              ; the grid closed where the view ends
        MOV     R2,R0
        INC     R0
        JSR     PC,SHOWN
        TST     R0
        BNE     31$
        BIS     #1,R1
31$:    MOV     R2,R0
        ADD     #PW,R0
        JSR     PC,SHOWN
        TST     R0
        BNE     32$
        BIS     #2,R1
32$:    MOV     TILE,R0
        JSR     PC,TILEDG
        MOV     R0,TILE
7$:     JSR     PC,PAPERS
        MOV     (SP)+,R1
        MOV     (SP)+,R0
        MOV     TILE,R2
        JSR     PC,DRAWC
        RTS     PC
TILES:  .WORD   TINF,TFRT1,TFRT2,TFAC
TILE:   .WORD   0
CURIDX: .WORD   0

; SHOWN: R0 = a cell; R0 = 1 when it is drawn as seen: in the game, in
; the human's view; at the title and in the demo, on the map.  Keeps R1
; and R2.
SHOWN:  CMP     MODE,#2
        BNE     1$
        TSTB    VISH(R0)
        BEQ     2$
        MOV     #1,R0
        RTS     PC
1$:     CMPB    BOARD(R0),#CEDGE
        BEQ     2$
        MOV     #1,R0
        RTS     PC
2$:     CLR     R0
        RTS     PC

; PAPERS: R2 = a cell; TATTR gets the paper of the selection, of the
; highlights of the computer's move, and the cursor's flash.
PAPERS: CMP     R2,SEL
        BNE     1$
        BISB    #ASEL,TATTR
1$:     CMP     R2,HILITE
        BNE     2$
        BICB    #70,TATTR
        BISB    #AHIL1,TATTR
2$:     CMP     R2,HILIT2
        BNE     3$
        BICB    #70,TATTR
        BISB    #AHIL2,TATTR
3$:     CMP     R2,FLASHC
        BNE     4$
        BICB    #70,TATTR
        BISB    #AFLS,TATTR
4$:     CMP     R2,CURIDX
        BNE     5$
        BISB    #AFLSH,TATTR
5$:     RTS     PC

; TILEDG: R0 = a tile, R1 = the edges to close: 1 the right, 2 the
; bottom.  R0 = the tile with them drawn (a copy in TBUF), or itself.
TILEDG: TST     R1
        BEQ     9$
        MOV     R2,-(SP)
        MOV     R3,-(SP)
        MOV     #TBUF,R2
        MOV     #32.,R3
1$:     MOVB    (R0)+,(R2)+
        SOB     R3,1$
        BIT     #1,R1
        BEQ     2$
        MOV     #TBUF+1,R2      ; the right column: bit 0 of every right byte
        MOV     #16.,R3
3$:     BISB    #1,(R2)
        ADD     #2,R2
        SOB     R3,3$
2$:     BIT     #2,R1
        BEQ     4$
        MOV     #-1,TBUF+30.    ; the bottom row
4$:     MOV     #TBUF,R0
        MOV     (SP)+,R3
        MOV     (SP)+,R2
9$:     RTS     PC
TBUF:   .BLKW   16.

; --- the title -------------------------------------------------------------
; The logo in the Spectrum's rainbow, a line under it, a field of the
; two armies drawn from the game's own tiles, the keys, the machine.
DRWTTL: JSR     PC,CLRSCR
        MOV     #9.,R0
        MOV     #12.,R1
        MOV     #LOGO,R2
        JSR     PC,DRAWBM
        MOVB    #ATXT,TATTR
        MOV     #13.,R0
        MOV     #56.,R1
        MOV     #TSUB,R2
        JSR     PC,TEXT
        MOV     #7,R0
        MOV     #152.,R1
        MOV     #TKEYS,R2
        JSR     PC,TEXT
        MOVB    #AHLP,TATTR
        MOV     #6,R0
        MOV     #184.,R1
        MOV     #TMACH,R2
        JSR     PC,TEXT
        MOV     #-1,SEL         ; no selection, no cursor, no highlights
        MOV     #-1,CURIDX
        MOV     #-1,HILITE
        MOV     #-1,HILIT2
        MOV     #-1,FLASHC
        CLR     R5              ; the field: four rows of twenty cells
1$:     CLR     R4
2$:     MOV     R5,R0           ; the letter at TTLMAP + y * 20 + x
        ASL     R0
        ASL     R0
        MOV     R0,R1
        ASL     R0
        ASL     R0
        ADD     R1,R0
        ADD     R4,R0
        MOVB    TTLMAP(R0),R0
        JSR     PC,TTLCEL
        CLR     R1              ; the grid closed at the field's edge
        CMP     R4,#WIDTH-1
        BNE     3$
        BIS     #1,R1
3$:     CMP     R5,#3
        BNE     4$
        BIS     #2,R1
4$:     MOV     TILE,R0
        JSR     PC,TILEDG
        MOV     R0,R2
        MOV     R4,R0
        MOV     R5,R1
        ADD     #5,R1
        JSR     PC,DRAWC
        INC     R4
        CMP     R4,#WIDTH
        BLO     2$
        INC     R5
        CMP     R5,#4
        BLO     1$
        RTS     PC

; TTLCEL: R0 = a letter of TTLMAP; TILE and TATTR for it - the human's
; I A B F, the computer's 1 2 3 4, anything else an empty cell.
TTLCEL: MOV     #TTLTAB,R1
1$:     CMP     (R1),R0
        BEQ     2$
        ADD     #6,R1
        TST     (R1)
        BNE     1$
2$:     MOV     2(R1),TILE
        MOVB    4(R1),TATTR
        RTS     PC
TTLTAB: .WORD   'I,TINF,AHUM+ABRT, 'A,TFRT1,AHUM+ABRT, 'B,TFRT2,AHUM+ABRT, 'F,TFAC,AHUM+ABRT
        .WORD   '1,TINF,ACPU+ABRT, '2,TFRT1,ACPU+ABRT, '3,TFRT2,ACPU+ABRT, '4,TFAC,ACPU+ABRT
        .WORD   0,TEMPTY,AEMP
TTLMAP: .ASCII  /..I.A.B.F..4.3.2.1../
        .ASCII  /.I.I..A.F..4.2..1.1./
        .ASCII  /..I.A.B.F..4.3.2.1../
        .ASCII  /.I.I..A.F..4.2..1.1./
TSUB:   .ASCIZ  /A WAR OF CELLS/
TKEYS:  .ASCIZ  /SPACE TO PLAY   Q TO LEAVE/
TMACH:  .ASCIZ  /FOR THE ELEKTRONIKA MS-0515/
        .EVEN

; STATUS: the round and the counts, the message, the keys.
STATUS: MOV     ROUND,R0
        MOV     #STLINE+6,R1
        JSR     PC,DEC3
        MOV     HCNT,R0
        MOV     #STLINE+16.,R1
        JSR     PC,DEC3
        MOV     CCNT,R0
        MOV     #STLINE+26.,R1
        JSR     PC,DEC3
        MOVB    #ATXT,TATTR
        MOV     #1,R0
        MOV     #168.,R1
        MOV     #STLINE,R2
        JSR     PC,TEXT
        MOV     #1,R0
        MOV     #184.,R1
        MOV     #BLANK,R2
        JSR     PC,TEXT
        MOV     #1,R0
        MOV     #184.,R1
        MOV     MSG,R2
        JSR     PC,TEXT
        MOVB    #AHLP,TATTR
        MOV     #1,R0
        MOV     #192.,R1
        MOV     #HELP,R2
        JSR     PC,TEXT
        RTS     PC

; DEC3: R0 (0..999) as three digits at R1.
DEC3:   MOV     #100.,R2
        JSR     PC,DIGIT
        MOV     #10.,R2
        JSR     PC,DIGIT
        ADD     #'0,R0
        MOVB    R0,(R1)+
        RTS     PC
DIGIT:  MOVB    #'0,(R1)
1$:     CMP     R0,R2
        BLO     2$
        SUB     R2,R0
        INCB    (R1)
        BR      1$
2$:     INC     R1
        RTS     PC

STLINE: .ASCIZ  /ROUND 000   YOU 000   CPU 000/
BLANK:  .ASCIZ  /                                      /
HELP:   .ASCIZ  /TAB SPACE ARROWS  S=SAVE L=LOAD Q=QUIT/
MYOUR:  .ASCIZ  /YOUR MOVE/
MINVAL: .ASCIZ  /IMPOSSIBLE MOVE/
MCPU:   .ASCIZ  /THE COMPUTER MOVES/
MWIN:   .ASCIZ  /YOU WIN!  N = NEW GAME/
MLOSE:  .ASCIZ  /YOU LOSE.  N = NEW GAME/
MSAVED: .ASCIZ  /GAME SAVED/
MLOADD: .ASCIZ  /GAME LOADED/
MNOSAV: .ASCIZ  /NO SAVED GAME/
MSVERR: .ASCIZ  /CANNOT SAVE/
MDEMO:  .ASCIZ  /DEMO: SPACE TO PLAY, Q TO LEAVE/
        .EVEN
MSG:    .WORD   MYOUR
MODE:   .WORD   0               ; 0 the title, 1 the demo, 2 the game
DEMOKY: .WORD   0               ; SPACE or Q pressed at the title or in the demo
VISP:   .WORD   VISH            ; the view of the player whose turn it is

; --- saving and loading -----------------------------------------------------
; The state below, SAVBEG to SAVEND, goes to DK:CELWAR.GAM as it is;
; loading it brings the game back where it was, mid-turn included.
SAVE:   .ENTER  #FAREA,#1,#FNAME,#SAVBLK
        BCS     9$
        .WRITW  #FAREA,#1,#SAVBEG,#SAVLEN,#0
        BCS     8$
        .CLOSE  #1
        MOV     #MSAVED,MSG
        RTS     PC
8$:     .CLOSE  #1
9$:     MOV     #MSVERR,MSG
        RTS     PC

LOAD:   .LOOKUP #FAREA,#1,#FNAME
        BCS     9$
        .READW  #FAREA,#1,#SAVBEG,#SAVLEN,#0
        BCS     8$
        .CLOSE  #1
        MOV     #VISH,VISP
        TST     TURN
        BEQ     1$
        MOV     #VISC,VISP
1$:     JSR     PC,WINCHK
        MOV     #MLOADD,MSG
        RTS     PC
8$:     .CLOSE  #1
9$:     MOV     #MNOSAV,MSG
        RTS     PC

FAREA:  .BLKW   5
FNAME:  .RAD50  /DK /
        .RAD50  /CELWAR/
        .RAD50  /GAM/

; --- the state ---------------------------------------------------------------------
        .EVEN
SAVBEG:
BOARD:  .BLKB   NCELLS
VISH:   .BLKB   NCELLS
VISC:   .BLKB   NCELLS
TURN:   .WORD   0               ; 0 the human, COWN the computer
PHASE:  .WORD   0               ; 0 the combat units, 1 the factories
ROUND:  .WORD   0
GSTATE: .WORD   0               ; 0 in play, 1 the human won, 2 the computer
SEL:    .WORD   0               ; the selected unit's cell, -1 none
CDX:    .WORD   0               ; the cursor's step from it
CDY:    .WORD   0
SEED:   .WORD   0
HCNT:   .WORD   0
CCNT:   .WORD   0
AIMEM:  .BLKW   2               ; the enemy each side saw last, -1 none
SAVEND:
SAVLEN = <SAVEND-SAVBEG>/2
SAVBLK = 3
        .END    START
